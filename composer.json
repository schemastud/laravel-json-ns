{
    "name": "schemastud/laravel-json-ns",
    "description": "The Laravel binding for the @namespace grammar \u2014 a URI-keyed dispatch socket over schemastud/php-json-ns + rushing/php-popcorn: bind your own namespace URI to your own handler (registered as a popcorn Invocable), with pick-one-by-URI (pinned > stem) resolution and a no-op-after-validation fallback.",
    "keywords": [
        "laravel",
        "json",
        "namespace",
        "curie",
        "dispatch",
        "popcorn",
        "invocable"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-popcorn": "*",
        "rushing/php-popcorn": "*",
        "schemastud/php-json-ns": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "schemastud/laravel-data-schemas": "*",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Schemastud\\JsonNs\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schemastud\\JsonNs\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schemastud\\JsonNs\\Laravel\\JsonNsServiceProvider"
            ]
        },
        "package-topology": {
            "mustRequire": [
                "schemastud/php-json-ns",
                "rushing/php-popcorn"
            ],
            "because": "The Laravel binding is the tier where the popcorn coupling rides: it wires the framework-free @namespace grammar (schemastud/php-json-ns) into the popcorn InvocableRegistry (rushing/php-popcorn) as a URI-keyed dispatch socket. Neither dependency may be dropped \u2014 the grammar has no dispatch, the registry has no namespace resolution; this package is exactly their join (asset 06 \u00a78)."
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/php-json-ns.git"
        }
    ]
}
